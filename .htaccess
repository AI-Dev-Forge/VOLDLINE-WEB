# Apache / LiteSpeed Security Configuration for VOLDLINE

<IfModule mod_headers.c>
    # Enforce HSTS (2 years with subdomains and preload eligibility)
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

    # Prevent MIME sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Deny framing / prevent clickjacking
    Header always set X-Frame-Options "DENY"

    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy disabling unnecessary sensors
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

    # Content Security Policy matching static web requirements
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; media-src 'self' blob:; connect-src 'self' https://api.github.com https://raw.githubusercontent.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';"
</IfModule>

# Block access to hidden files and directories (like .git, .env)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Prevent directory browsing
Options -Indexes

